{
  "name": "faktura",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "backup": "tsx scripts/backup.ts",
    "seed": "tsx scripts/seed.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run audit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "user:create": "tsx --env-file=.env scripts/create-user.ts",
    "admin:create": "tsx --env-file=.env scripts/create-admin.ts",
    "admin:reset": "tsx --env-file=.env scripts/reset-admin.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build:cli": "esbuild scripts/create-user.ts scripts/create-admin.ts scripts/reset-admin.ts --bundle --platform=node --format=esm --target=node24 --alias:@=./src --external:@prisma/client --external:@node-rs/argon2 --outdir=dist --out-extension:.js=.mjs --log-level=warning"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/fira-mono": "5.3.0",
    "@fontsource/fira-sans": "5.3.0",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.3",
    "@simplewebauthn/browser": "13.2.2",
    "@simplewebauthn/server": "13.3.2",
    "adm-zip": "0.6.0",
    "liquidjs": "10.28.0",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "otpauth": "9.5.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "playwright": "1.62.1",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/adm-zip": "0.5.8",
    "@types/node": "24.13.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.26",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
