// Datenmodell nach Spec §4. Das Schema wächst meilensteinweise:
// M0 legt den Datenbankzugang und das schichtübergreifende Audit-Log an,
// M1 ergänzt User und Session, M2 die Stammdaten, M4 die Belege.

generator client {
  provider = "prisma-client-js"
  // Die Abfrage-Engine wird zur Bauzeit ausgewählt. Ohne ausdrückliche Angabe
  // rät Prisma anhand der Bauumgebung — und liefert eine Engine für die falsche
  // OpenSSL-Version aus, sobald sich Bau- und Laufzeitumgebung unterscheiden.
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Stammdaten ─────────────────────────────────────────────────────────────

/// Die eigenen Firmendaten. Singleton mit fester Kennung 1.
///
/// Prisma allein erzwingt das nicht — `@default(1)` verhindert keinen zweiten
/// Datensatz. Die Migration ergänzt deshalb eine CHECK-Bedingung auf
/// Datenbankebene, und der Zugriff läuft ausschließlich über `upsert` mit
/// `id: 1` in einer einzigen Repository-Funktion.
model CompanyProfile {
  id           Int     @id @default(1)
  legalName    String
  addressLine1 String
  addressLine2 String?
  postalCode   String
  city         String
  countryCode  String  @default("DE")
  email        String?
  phone        String?
  website      String?

  taxNumber       String?
  vatId           String?
  isSmallBusiness Boolean @default(false)

  registerCourt    String?
  registerNumber   String?
  managingDirector String?

  bankAccountHolder String?
  iban              String?
  bic               String?
  bankName          String?

  logoAssetId String?
  logoAsset   Asset?  @relation(fields: [logoAssetId], references: [id])

  defaultPaymentTerms Int      @default(14)
  defaultTaxRate      Int      @default(19)
  defaultCurrency     String   @default("EUR")
  footerText          String?
  invoiceNumberFormat String   @default("RE-{YYYY}-{SEQ:4}")
  updatedAt           DateTime @updatedAt
}

model Customer {
  id             String  @id @default(cuid())
  customerNumber String  @unique
  companyName    String?
  contactName    String?
  addressLine1   String
  addressLine2   String?
  postalCode     String
  city           String
  countryCode    String  @default("DE")
  email          String?
  phone          String?
  vatId          String?
  /// BT-10, Leitweg-ID für Rechnungen an öffentliche Auftraggeber.
  buyerReference String?
  /// Überschreibt das Standard-Zahlungsziel aus dem Firmenprofil.
  paymentTerms   Int?
  notes          String?
  /// Kunden werden archiviert, nie gelöscht (Spec §4.1).
  isArchived     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isArchived])
  @@index([customerNumber])
}

/// Wiederverwendbare Positionen für den Rechnungseditor (FA-STAMM-10).
model CatalogItem {
  id             String  @id @default(cuid())
  name           String
  description    String?
  unitPriceCents Int
  unitCode       String  @default("C62")
  taxRate        Int     @default(19)
  isArchived     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isArchived])
}

/// Hochgeladene Dateien. Liegen außerhalb des ausgelieferten Verzeichnisses
/// und sind nur über eine authentifizierte Route erreichbar (NFA-SEC-16).
model Asset {
  id          String   @id @default(cuid())
  fileName    String
  mimeType    String
  byteSize    Int
  sha256      String
  storagePath String
  createdAt   DateTime @default(now())

  companyProfiles CompanyProfile[]
}

/// Fortlaufende Zähler. In M2 für Kundennummern, ab M3 für Belegnummern.
model NumberSequence {
  id        String @id @default(cuid())
  scope     String @unique
  lastValue Int    @default(0)
}

// ─── Authentifizierung ──────────────────────────────────────────────────────

/// Benutzerkonto. Es gibt keine öffentliche Registrierung; das erste Konto
/// wird über `npm run user:create` angelegt (NFA-SEC-02).
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions      Session[]
  recoveryCodes RecoveryCode[]
}

/// Angemeldete Sitzung. In der Datenbank liegt ausschließlich der SHA-256-Hash
/// des Sitzungstokens (NFA-SEC-06) — wer die Datenbank liest, kann sich damit
/// nicht anmelden.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  /// Abweichung von Spec §4: für die Sitzungsübersicht (NFA-SEC-09) — ohne
  /// diesen Zeitpunkt lässt sich eine verwaiste von einer aktiven Sitzung
  /// nicht unterscheiden.
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Einmal verwendbare Wiederherstellungscodes für den Fall eines verlorenen
/// TOTP-Geräts (NFA-SEC-05).
///
/// Abweichung von Spec §4: Die Spezifikation nennt Recovery-Codes in §11.1,
/// modelliert sie aber nicht. Gespeichert wird nur der Hash; im Klartext
/// erscheinen die Codes genau einmal, direkt nach der Erzeugung.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── Betrieb ────────────────────────────────────────────────────────────────

/// Protokoll aller Änderungen an Rechnungen und Stammdaten (NFA-COMP-01).
/// Einträge werden ausschließlich angelegt, nie geändert oder gelöscht
/// (NFA-COMP-02) — die Durchsetzung folgt mit M4.
model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String?
  diffJson   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
