// Datenmodell nach Spec §4. Das Schema wächst meilensteinweise:
// M0 legt den Datenbankzugang und das schichtübergreifende Audit-Log an,
// M1 ergänzt User und Session, M2 die Stammdaten, M3 die Belege.

generator client {
  provider      = "prisma-client-js"
  // Die Abfrage-Engine wird zur Bauzeit ausgewählt. Ohne ausdrückliche Angabe
  // rät Prisma anhand der Bauumgebung — und liefert eine Engine für die falsche
  // OpenSSL-Version aus, sobald sich Bau- und Laufzeitumgebung unterscheiden.
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Mandant ────────────────────────────────────────────────────────────────

/// Die Organisation, der alle kaufmännischen Daten gehören.
///
/// V1 arbeitet mit genau einer, die beim Einrichten angelegt wird. Die Spalte
/// `organizationId` auf den mandantengebundenen Tabellen macht den Umstieg auf
/// mehrere Mandanten zu einer Erweiterung statt zu einem Umbau — und wäre
/// nachträglich nur mit einer Datenmigration einzuführen.
///
/// Sie trägt nur die technische Identität; die kaufmännischen Stammdaten
/// stehen in `CompanyProfile`, das 1:1 daran hängt.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  /// Stillgelegt durch den Betreiber (M8, FA-ORG-03). Beendet alle Sitzungen
  /// und weist die Anmeldung ab — ohne Daten zu löschen.
  suspendedAt DateTime?

  companyProfile  CompanyProfile?
  users           User[]
  roles           Role[]
  templates       Template[]
  artifacts       InvoiceArtifact[]
  customers       Customer[]
  catalogItems    CatalogItem[]
  assets          Asset[]
  numberSequences NumberSequence[]
  invoices        Invoice[]
  invoiceLines    InvoiceLine[]
  payments        Payment[]
  auditEntries    AuditLog[]
  invitations     Invitation[]
}

// ─── Stammdaten ─────────────────────────────────────────────────────────────

/// Die eigenen Firmendaten — genau ein Datensatz je Organisation.
///
/// Die Eindeutigkeit erzwingt seit M5.5a `@@unique([organizationId])`. Zuvor
/// stand hier eine CHECK-Bedingung auf `id = 1`; die entfällt, weil der
/// Singleton jetzt mandantenbezogen ist.
model CompanyProfile {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalName      String
  addressLine1   String
  addressLine2   String?
  postalCode     String
  city           String
  countryCode    String       @default("DE")
  email          String?
  phone          String?
  website        String?

  taxNumber       String?
  vatId           String?
  isSmallBusiness Boolean @default(false)

  registerCourt    String?
  registerNumber   String?
  managingDirector String?

  bankAccountHolder String?
  iban              String?
  bic               String?
  bankName          String?

  logoAssetId String?
  logoAsset   Asset?  @relation(fields: [logoAssetId], references: [id])

  defaultPaymentTerms       Int      @default(14)
  /// Steuersatz in Basispunkten: 1900 = 19 %. Deckt auch Sätze mit
  /// Nachkommastellen ab (8,1 % CH, 2,5 % AT) und bleibt ganzzahlig.
  defaultTaxRateBasisPoints Int      @default(1900)
  defaultCurrency           String   @default("EUR")
  footerText                String?
  invoiceNumberFormat       String   @default("RE-{YYYY}-{SEQ:4}")
  /// Muster für den Dateinamen erzeugter PDFs (FA-PDF-09).
  pdfFileNamePattern        String   @default("{NUMBER}")
  updatedAt                 DateTime @updatedAt
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerNumber String
  companyName    String?
  contactName    String?
  addressLine1   String
  addressLine2   String?
  postalCode     String
  city           String
  countryCode    String       @default("DE")
  email          String?
  phone          String?
  vatId          String?
  /// BT-10, Leitweg-ID für Rechnungen an öffentliche Auftraggeber.
  buyerReference String?
  /// Überschreibt das Standard-Zahlungsziel aus dem Firmenprofil.
  paymentTerms   Int?
  notes          String?
  /// Kunden werden archiviert, nie gelöscht (Spec §4.1).
  isArchived     Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  /// Kundennummern sind je Organisation eindeutig, nicht global.
  @@unique([organizationId, customerNumber])
  @@index([organizationId, isArchived])
}

/// Wiederverwendbare Positionen für den Rechnungseditor (FA-STAMM-10).
model CatalogItem {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  unitPriceCents     Int
  unitCode           String       @default("C62")
  /// Basispunkte: 1900 = 19 %.
  taxRateBasisPoints Int          @default(1900)
  isArchived         Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, isArchived])
}

/// Hochgeladene Dateien. Liegen außerhalb des ausgelieferten Verzeichnisses
/// und sind nur über eine authentifizierte Route erreichbar (NFA-SEC-16).
model Asset {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fileName       String
  mimeType       String
  byteSize       Int
  sha256         String
  storagePath    String
  createdAt      DateTime     @default(now())

  companyProfiles CompanyProfile[]

  @@index([organizationId])
}

/// Fortlaufende Zähler. In M2 für Kundennummern, ab M3 für Belegnummern.
model NumberSequence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scope          String
  lastValue      Int          @default(0)

  /// Der Zählerbereich gilt je Organisation — sonst zählte die zweite im
  /// Nummernkreis der ersten weiter.
  @@unique([organizationId, scope])
}

// ─── Belege ─────────────────────────────────────────────────────────────────

/// Rechnung oder Stornorechnung.
///
/// Kalendertage stehen als `YYYY-MM-DD` in der Datenbank, nicht als DateTime:
/// Als Zeitpunkt gespeichert läge der 1. März in Berlin als
/// `2026-02-28T23:00:00Z` vor, und Monatsumsatz wie Überfälligkeit kippten an
/// der Tagesgrenze. Die Textform sortiert lexikografisch gleich chronologisch,
/// Zeitraumfilter funktionieren damit unverändert.
///
/// `documentType` und `status` sind Zeichenketten, weil SQLite keine
/// Aufzählungstypen kennt. Die Aufzählung selbst liegt in der Domain
/// (`src/domain/document/document-type.ts`, `src/domain/invoice/status.ts`)
/// und wird beim Schreiben geprüft (NFA-ARCH-09).
model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentType   String       @default("INVOICE")
  /// Erst beim Festschreiben vergeben (FA-NUM-02). Eindeutig je Organisation.
  invoiceNumber  String?
  status         String       @default("DRAFT")

  /// Woher der Empfänger stammt (M5.7).
  ///
  /// `CUSTOMER` — aus den Stammdaten, `customerId` ist gesetzt.
  /// `FIELDS`   — am Beleg erfasst, in denselben Feldern wie beim Kunden.
  /// `FREE`     — ein Textblock, wie eingegeben.
  ///
  /// Ein Beleg ohne hinterlegten Kunden ist der Regelfall bei einmaligen
  /// Empfängern: Wer einmal an jemanden schreibt, will dafür keinen Datensatz
  /// in den Stammdaten anlegen.
  buyerMode String @default("CUSTOMER")

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  /// Empfänger im Modus `FIELDS`. Spiegelt die Felder des Kunden, weil die
  /// steuerliche Behandlung an Land und USt-IdNr hängt (FA-CALC-06, -07) und
  /// die Pflichtangaben dieselben sind (FA-PFL-01).
  buyerName         String?
  buyerContactName  String?
  buyerAddressLine1 String?
  buyerAddressLine2 String?
  buyerPostalCode   String?
  buyerCity         String?
  buyerCountryCode  String?
  buyerEmail        String?
  buyerPhone        String?
  buyerVatId        String?

  /// Empfänger im Modus `FREE`: der Anschriftenblock, Zeile für Zeile wie
  /// eingegeben. Ein Name wird daraus beim Lesen abgeleitet (erste nichtleere
  /// Zeile) — ihn zusätzlich zu speichern hieße, zwei Wahrheiten zu pflegen.
  buyerFreeText String?

  /// Beim Festschreiben eingefrorene Käufer- und Verkäuferdaten (M4).
  snapshotBuyer  String?
  snapshotSeller String?

  issueDate       String?
  serviceDateFrom String?
  serviceDateTo   String?
  dueDate         String?

  currency String @default("EUR")

  /// Abweichung von Spec §4: Die Spezifikation modelliert die steuerliche
  /// Behandlung nur je Position. FA-CALC-08 verlangt sie je Rechnung — und die
  /// Pflichthinweise (§19, Reverse Charge) lassen sich aus den Positionen
  /// allein nicht ableiten, etwa bei einem Beleg ohne Positionen.
  taxScheme String @default("STANDARD")

  introText        String?
  outroText        String?
  purchaseOrderRef String?

  /// Stornobezug, BT-25/BT-26.
  precedingInvoiceId String?
  precedingInvoice   Invoice?  @relation("Cancellation", fields: [precedingInvoiceId], references: [id])
  cancelledBy        Invoice[] @relation("Cancellation")

  /// Abweichende Vorlage je Beleg (FA-TPL-03); ohne Angabe gilt die
  /// Standardvorlage der Organisation.
  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  lines     InvoiceLine[]
  payments  Payment[]
  artifacts InvoiceArtifact[]

  /// Denormalisierte Summen in Cent, bei jeder Änderung neu berechnet.
  netTotalCents   Int @default(0)
  taxTotalCents   Int @default(0)
  grossTotalCents Int @default(0)
  paidTotalCents  Int @default(0)

  /// Wer den Beleg angelegt hat (M8, FA-UI-16).
  ///
  /// Optional, und das bleibt es: Bestandsbelege aus der Zeit vor M8 tragen
  /// hier `NULL` und behalten es. Sie nachträglich aus dem Protokoll
  /// zuzuschreiben hieße raten — und eine geratene Urheberschaft an einem
  /// unveränderlichen Beleg ist schlimmer als eine leere.
  createdById String?
  createdBy   User?   @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  issuedAt    DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, customerId])
  @@index([organizationId, issueDate])
  @@index([organizationId, documentType, status])
}

/// Rechnungsposition.
///
/// `organizationId` ist hier redundant — maßgeblich gefiltert wird über
/// `invoice.organizationId`, damit es genau einen Abfragepfad gibt. Die Spalte
/// steht trotzdem da: Spec §13 sieht den Umstieg auf PostgreSQL vor, und dessen
/// Row Level Security wirkt je Tabelle. Ohne die Spalte bliebe diese Tabelle
/// davon ausgenommen. Ein Trigger erzwingt Gleichheit mit der Rechnung.
model InvoiceLine {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position       Int

  name        String
  description String?

  /// Menge als skalierte Ganzzahl mit vier Nachkommastellen: 1,5 = 15000.
  /// Ein Decimal-Feld legte SQLite als REAL ab und brächte damit
  /// Fließkommazahlen in die Berechnungskette (FA-CALC-01).
  quantityScaled Int
  unitCode       String @default("C62")
  unitPriceCents Int

  /// Basispunkte: 1900 = 19 %.
  taxRateBasisPoints  Int
  taxCategory         String @default("S")
  /// Basispunkte: 1250 = 12,5 %.
  discountBasisPoints Int    @default(0)

  /// Berechnet und persistiert — die Berechnung liegt in der Domain.
  lineNetCents Int

  @@unique([invoiceId, position])
  @@index([invoiceId])
}

/// Zahlungseingang. `organizationId` aus demselben Grund wie bei
/// `InvoiceLine`: Absicherung für Row Level Security, nicht Abfragepfad.
model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amountCents Int
  /// Kalendertag des Zahlungseingangs, `YYYY-MM-DD`.
  paidAt      String
  method      String?
  note        String?

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

/// Erzeugte Belegdateien — unveränderlich, mit Hash zur Integritätsprüfung.
///
/// Das Artefakt ist der Grund, warum eine spätere Vorlagenänderung ein bereits
/// erzeugtes PDF nicht verändert (FA-TPL-09): Ausgeliefert wird die Datei, die
/// beim Festschreiben entstanden ist, nicht ein bei jedem Abruf neu gesetztes
/// Dokument. Der Hash macht eine nachträgliche Veränderung erkennbar.
model InvoiceArtifact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// `pdf`; [V2] `zugferd-pdf`, `xrechnung-xml`.
  kind      String   @default("pdf")
  filePath  String
  sha256    String
  byteSize  Int
  /// Der Dateiname, unter dem das Artefakt ausgeliefert wird (FA-PDF-09).
  fileName  String
  createdAt DateTime @default(now())

  /// Je Beleg und Art genau ein Artefakt — ein zweites PDF derselben Rechnung
  /// wäre eine zweite Wahrheit.
  @@unique([invoiceId, kind])
  @@index([organizationId, createdAt])
}

// ─── Vorlagen ───────────────────────────────────────────────────────────────

/// Rechnungsvorlage aus Liquid-HTML und CSS (Spec §8.1).
///
/// Abweichung von Spec §4: Die Ränder stehen in vier Ganzzahlspalten statt in
/// einem `Json`-Feld. SQLite legte `Json` als Text ab; Millimeterangaben wären
/// dann weder typisiert noch prüfbar, und ein Tippfehler fiele erst beim
/// Rendern auf.
model Template {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  htmlSource  String
  cssSource   String

  pageFormat     String @default("A4")
  marginTopMm    Int    @default(25)
  marginRightMm  Int    @default(20)
  marginBottomMm Int    @default(20)
  marginLeftMm   Int    @default(20)

  /// Genau eine Vorlage je Organisation trägt die Marke; erzwungen von einem
  /// partiellen eindeutigen Index, den die Migration anlegt (FA-TPL-02).
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ─── Authentifizierung ──────────────────────────────────────────────────────

/// Benutzerkonto. Es gibt keine öffentliche Registrierung; das erste Konto
/// wird über `npm run user:create` angelegt (NFA-SEC-02).
model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Global eindeutig, nicht je Organisation: Die Anmeldung löst allein über
  /// die Adresse auf — es gibt kein Feld, in dem der Mandant mit angegeben wird.
  email          String       @unique
  passwordHash   String
  totpSecret     String?
  totpEnabled    Boolean      @default(false)
  failedLogins   Int          @default(0)
  lockedUntil    DateTime?
  /// Erfasster Name für Mitgliederliste und Urheberangabe (M8). Bis dahin
  /// leiteten sich Initialen aus der Adresse ab.
  name           String?
  /// Gesperrt statt gelöscht (M8): Der Beleg behält seinen Urheber, und die
  /// Nachvollziehbarkeit geht vor Wiederverwendbarkeit der Adresse.
  disabledAt     DateTime?
  lastLoginAt    DateTime?
  /// Optional, weil sie beim Anlegen über die Migration erst gesetzt wird und
  /// weil `onDelete: Restrict` eine benutzte Rolle vor dem Löschen schützt.
  roleId         String?
  role           Role?        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sessions        Session[]
  recoveryCodes   RecoveryCode[]
  trustedDevices  TrustedDevice[]
  passkeys        WebAuthnCredential[]
  /// Belege, die dieses Konto angelegt hat (M8, FA-UI-16).
  ///
  /// `onDelete: SetNull` an der Gegenseite ist kein Zugeständnis: Ein Konto wird
  /// nie gelöscht, sondern gesperrt — gerade damit der Beleg seinen Urheber
  /// behält. Die Regel steht da für den Fall, dass eine ganze Organisation
  /// entfernt wird.
  createdInvoices Invoice[]            @relation("InvoiceCreatedBy")
  pendingLogins   PendingLogin[]
  passwordResets  PasswordReset[]
  /// Von diesem Konto ausgesprochene Einladungen. `onDelete: SetNull` an der
  /// Gegenseite: Ein gesperrtes Konto wird nie gelöscht, aber die Einladung
  /// überdauert ohnehin, wer sie ausgesprochen hat.
  sentInvitations Invitation[]         @relation("InvitationInvitedBy")

  @@index([organizationId])
  @@index([roleId])
}

/// Angemeldete Sitzung. In der Datenbank liegt ausschließlich der SHA-256-Hash
/// des Sitzungstokens (NFA-SEC-06) — wer die Datenbank liest, kann sich damit
/// nicht anmelden.
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  /// Abweichung von Spec §4: für die Sitzungsübersicht (NFA-SEC-09) — ohne
  /// diesen Zeitpunkt lässt sich eine verwaiste von einer aktiven Sitzung
  /// nicht unterscheiden.
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Einmal verwendbare Wiederherstellungscodes für den Fall eines verlorenen
/// TOTP-Geräts (NFA-SEC-05).
///
/// Abweichung von Spec §4: Die Spezifikation nennt Recovery-Codes in §11.1,
/// modelliert sie aber nicht. Gespeichert wird nur der Hash; im Klartext
/// erscheinen die Codes genau einmal, direkt nach der Erzeugung.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Eine Rolle innerhalb eines Unternehmens (M8, FA-ROLE-01).
///
/// **Jedes Unternehmen legt seine eigenen an.** Es gibt kein festes Rollenset —
/// ein Betrieb mit Buchhaltungskraft braucht andere Zuschnitte als einer, in
/// dem zwei Gesellschafter alles machen. Was fest ist, ist der Katalog der
/// Berechtigungen (`src/domain/policy/can.ts`); wie man sie bündelt, entscheidet
/// das Unternehmen.
model Role {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  permissions RolePermission[]
  users       User[]
  invitations Invitation[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Ein erteiltes Recht (M8).
///
/// **Verknüpfungstabelle statt Menge in einer Spalte.** SQLite kennt keinen
/// Array- und keinen Aufzählungstyp; eine Textspalte macht Tippfehler unsichtbar
/// und Duplikate möglich. Entscheidend ist aber die Aussperrsicherung
/// (FA-ROLE-04): Als Trigger kann sie hier Zeilen **zählen**, statt in einer
/// Zeichenkette suchen zu müssen.
///
/// `organizationId` wird mitgeführt wie bei `InvoiceLine` — Vorbereitung auf
/// Row Level Security unter PostgreSQL (Spec §13), gleichgehalten durch Trigger.
model RolePermission {
  id             String @id @default(cuid())
  organizationId String
  roleId         String
  role           Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// Ein Schlüssel aus `ALL_PERMISSION_KEYS`. Kein Fremdschlüssel: Ein
  /// unbekannter Schlüssel gewährt nichts (FA-ROLE-06), also verschiebt er
  /// keine Grenze — anders als eine falsche `organizationId`.
  permissionKey  String

  @@unique([roleId, permissionKey])
  @@index([organizationId])
}

/// Ein Betreiberkonto für die zentrale Verwaltung (M8).
///
/// **Bewusst eine eigene Tabelle, kein Merkmal an `User`.** Der Auftraggeber
/// hat entschieden: Die Verwaltung sieht keine Geschäftsdaten. Das ist entweder
/// eine Zusage oder eine Eigenschaft des Typsystems — und als Zusage wäre sie
/// nur so viel wert wie die Sorgfalt an jeder einzelnen Abfrage.
///
/// Als eigene Tabelle wird sie zur Eigenschaft: Eine Adminsitzung führt keinen
/// `OrganizationContext`, und da jede Funktion in `infrastructure/repositories`
/// einen als ersten Pflichtparameter verlangt, ist eine Abfrage von
/// Geschäftsdaten aus dem Adminbereich ein **Übersetzungsfehler**.
///
/// Drei weitere Gründe gegen ein Merkmal an `User`: Ein `User` braucht eine
/// `organizationId` und stünde damit in der Mitgliederliste und im Datenexport
/// eines Mandanten; `User.email` ist global eindeutig, die Adminadresse
/// verbrauchte also einen Platz im Adressraum der Mandanten; und beide teilten
/// sich ein Sitzungscookie, sodass ein versehentlicher Aufruf von `/invoices`
/// eine gültige Antwort mit fremden Belegen ergäbe.
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  /// Für Adminkonten verpflichtend (FA-ADM-08): Wer Unternehmen sperren kann,
  /// sichert sich mit mehr als einem Passwort.
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  disabledAt   DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions      AdminSession[]
  pendingLogins PendingLogin[]
  passkeys      WebAuthnCredential[]
}

/// Ein Einrichtungsnachweis für ein Betreiberkonto (M8, FA-ADM-06, -08).
///
/// **Das Konto entsteht erst beim Einlösen.** `npm run admin:create` legt keinen
/// `AdminUser` an, sondern diese Zeile; Passwort und zweiter Faktor werden im
/// Browser gesetzt. Damit gibt es zu keinem Zeitpunkt ein Betreiberkonto ohne
/// zweiten Faktor — dieselbe Zusage wie zuvor, nur ohne dass das Geheimnis durch
/// ein Terminal muss.
///
/// **Das TOTP-Geheimnis steht schon hier**, nicht erst beim Absenden des
/// Formulars. Der Grund ist die Erfahrung aus der Mitgliederverwaltung: Läge es
/// in einem versteckten Formularfeld, erzeugte jedes Neuladen ein neues — wer
/// den ersten QR-Code gescannt hat, bestätigte gegen das zweite Geheimnis und
/// bekäme eine Fehlermeldung, die nichts erklärt.
///
/// Ohne den Token ist das Geheimnis wertlos: Es gehört zu keinem Konto, und es
/// gibt keines, an dem man sich damit anmelden könnte.
model AdminInvitation {
  id         String    @id @default(cuid())
  email      String
  /// Wie bei jedem Nachweis liegt nur der SHA-256-Hash (NFA-SEC-06).
  tokenHash  String    @unique
  /// Wandert beim Einlösen unverändert an den `AdminUser`.
  totpSecret String
  /// `CREATE` — es soll ein Konto entstehen. `RESET` — ein vorhandenes bekommt
  /// neue Zugangsdaten.
  ///
  /// Die Unterscheidung ist eine Sicherung, keine Bequemlichkeit: Ohne sie
  /// könnte ein Nachweis, der für ein **neues** Konto ausgestellt wurde, ein
  /// Konto überschreiben, das inzwischen auf anderem Weg entstanden ist. Beim
  /// Einlösen wird geprüft, dass die Lage zur Absicht passt — und ein
  /// unbekannter Wert lässt beide Zweige leer ausgehen und den Versuch
  /// scheitern.
  kind       String    @default("CREATE")
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

/// Sitzung eines Betreiberkontos — getrennt von `Session`, mit eigenem Cookie
/// und eigenem Pfad (`/admin`). Das Admintoken liegt damit bei keiner Anfrage
/// an `/invoices` bei.
model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())

  @@index([adminUserId])
  @@index([expiresAt])
}

/// Der Zwischenzustand zwischen Passwort und zweitem Faktor (seit M6.2).
///
/// Wird die Anmeldung auf zwei Seiten geteilt, muss der erste Schritt dem
/// zweiten beweisen können, dass das Passwort stimmte — ohne dabei schon
/// Zugang zu gewähren. Genau das ist diese Zeile: ein Nachweis mit kurzer
/// Frist und ohne jedes Recht.
///
/// **Bewusst eine eigene Tabelle, keine Sitzung mit Merkmal.** Läge der
/// Zwischenzustand als `Session` mit einem Feld „zweiter Faktor fehlt noch",
/// hinge die gesamte Zweifaktorauthentifizierung daran, dass jede Abfrage auf
/// Sitzungen dieses Feld mitprüft. Eine vergessene Stelle genügte, und der
/// zweite Faktor wäre umgangen. Als eigener Typ an eigenem Ort kann er von
/// keiner Sitzungsabfrage gefunden werden.
model PendingLogin {
  id          String     @id @default(cuid())
  /// Genau eines von beiden ist gesetzt: Der zweite Schritt gilt für ein
  /// Mandanten- **oder** ein Betreiberkonto. Ein `CHECK` in der Migration hält
  /// das fest.
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  /// Wie beim Sitzungstoken liegt hier nur der SHA-256-Hash (NFA-SEC-06).
  tokenHash   String     @unique
  ipAddress   String?
  expiresAt   DateTime
  createdAt   DateTime   @default(now())

  @@index([userId])
  @@index([adminUserId])
  @@index([expiresAt])
}

// ─── Betrieb ────────────────────────────────────────────────────────────────

/// Protokoll aller Änderungen an Rechnungen und Stammdaten (NFA-COMP-01).
/// Einträge werden ausschließlich angelegt, nie geändert oder gelöscht
/// (NFA-COMP-02) — die Durchsetzung folgt mit M4.
/// Protokoll der **Verwaltung** (M10, FA-ADM-14).
///
/// Eine zweite Tabelle neben `AuditLog`, und die Trennung ist der Punkt:
///
/// - `AuditLog` gehört einem **Unternehmen**. Was der Betreiber dort tut, steht
///   mit `actorKind: 'ADMIN'` darin, damit die Betroffenen es sehen (FA-ADM-07).
/// - `PlatformAuditEntry` gehört der **Anlage**. Hier steht, was ein Betreiber
///   getan hat — auch das, was kein Unternehmen betrifft: ein Betreiberkonto
///   einladen, sperren, zurücksetzen.
///
/// Der Betreiber liest damit **nie** das Protokoll eines Mandanten. Das ist
/// stärker als ein Filter auf `actorKind`: Ein Filter kann vergessen werden, eine
/// getrennte Tabelle enthält die fremden Zeilen gar nicht erst. Der Preis ist,
/// dass ein Eingriff mit Unternehmensbezug zweimal steht — einmal für jede
/// Leserschaft, mit unterschiedlicher Reichweite.
///
/// `actorId` und `organizationId` sind **Text ohne Fremdschlüssel**, wie
/// `AuditLog.actorId`: Ein Protokoll beschreibt, was war, und muss auch dann
/// lesbar bleiben, wenn der Gegenstand nicht mehr aufzulösen ist.
model PlatformAuditEntry {
  id String @id @default(cuid())

  /// Kennung des handelnden `AdminUser`.
  actorId String

  /// Das betroffene Unternehmen — leer bei Vorgängen ohne Unternehmensbezug.
  organizationId String?

  entityType  String
  entityId    String
  action      String
  detailsJson String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String
  entityId       String
  action         String
  actorId        String?
  /// Wer gehandelt hat: ein Mitglied des Unternehmens (`USER`) oder der
  /// Betreiber (`ADMIN`) — M8, FA-ADM-07. Ohne diese Angabe ließe sich eine
  /// Handlung der Verwaltung nicht von einer des Unternehmens unterscheiden,
  /// und `actorId` allein trägt die Auskunft nicht: Die Kennungen stammen aus
  /// zwei verschiedenen Tabellen.
  actorKind      String       @default("USER")
  diffJson       String?
  ipAddress      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
}

/// Eine Einladung in ein Unternehmen (M8, FA-MEMB-01..03, -05, -07).
///
/// **Nur der Hash des Tokens** liegt hier, wie beim Sitzungstoken und beim
/// Nachweis des zweiten Anmeldeschritts (NFA-SEC-06). Der Link erscheint genau
/// einmal in der Oberfläche und wird außerhalb der Anwendung weitergereicht —
/// die Anwendung versendet keine E-Mail und darf keine (NFA-COMP-05).
///
/// **Kein Passwort und kein Passworthash.** Der Eingeladene setzt sein Passwort
/// selbst; kein anderes Konto kennt es je. Ein Feld dafür wäre die Einladung
/// dazu, es doch zu vergeben.
model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Die Adresse, für die die Einladung gilt. Global eindeutig ist am Ende
  /// `User.email`; hier hält ein partieller Index fest, dass es je Adresse nur
  /// **eine offene** Einladung gibt (FA-MEMB-07).
  email          String
  /// Die Rolle, die das Konto beim Annehmen erhält. `Restrict`, weil eine Rolle
  /// mit offener Einladung nicht verschwinden darf — sonst entstünde beim
  /// Annehmen ein Konto ohne Rolle.
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  tokenHash      String       @unique
  invitedById    String?
  invitedBy      User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt      DateTime
  /// Gesetzt beim Annehmen. Eine angenommene Einladung ist verbraucht, nicht
  /// gelöscht: Das Protokoll soll den Weg eines Kontos noch zeigen können.
  acceptedAt     DateTime?
  /// Zurückgezogen. Für den Aufrufer der Einlöseseite **ununterscheidbar** von
  /// abgelaufen und von unbekannt (FA-MEMB-05).
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([roleId])
  @@index([email])
  @@index([expiresAt])
}

/// Ein einmalig einlösbarer Nachweis zum Setzen eines neuen Passworts
/// (M8, FA-MEMB-04).
///
/// Ausgelöst wird er von der Rechteverwaltung des Unternehmens, nicht vom
/// Betroffenen: Es gibt keinen E-Mail-Versand, also auch keinen Weg, einen Link
/// an eine unbestätigte Adresse zu schicken. Wer ihn auslöst, gibt ihn weiter.
///
/// Dass er **kein** neues Passwort setzt, sondern nur dazu berechtigt, ist der
/// Punkt: Die Rechteverwaltung kennt das Passwort eines Mitglieds nie.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Ein Gerät, dem der zweite Faktor eine Zeit lang erlassen wird (M9, FA-TRUST-*).
///
/// **Nur für Mandantenkonten.** Betreiberkonten geben ihn jedes Mal ein: Wer
/// Unternehmen stilllegen kann, sichert sich jedes Mal (FA-ADM-08).
///
/// Der Eintrag ist ein **Ersatz für einen Faktor**, also so stark zu behandeln
/// wie ein Sitzungstoken: 256 Bit Entropie, in der Datenbank nur der
/// SHA-256-Hash, jederzeit einzeln widerrufbar.
///
/// **Gebunden an das Konto, nicht nur an den Token.** Geprüft wird mit `userId`
/// **und** Hash. Ohne die Bindung wäre ein entwendetes Cookie ein
/// Universalschlüssel: Es überspränge den zweiten Faktor für jedes Konto, dessen
/// Passwort der Angreifer kennt.
model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  /// Für die Anzeige unter „Vertraute Geräte" — dieselbe Angabe wie bei den
  /// Sitzungen, damit man sie einander zuordnen kann.
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  lastUsedAt DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Ein registrierter Passkey (M9, FA-PASS-*).
///
/// **Ein Faktor, der nicht wandert.** Der private Schlüssel verlässt das Gerät
/// nie; hier liegt nur der öffentliche. Die Signatur bindet sich an die Herkunft
/// der aufrufenden Seite — Phishing läuft ins Leere, weil ein Authenticator
/// einer falschen Domain nichts gibt.
///
/// Wie `PendingLogin` gehört der Eintrag zu **genau einem** Konto, Mandant oder
/// Betreiber; ein CHECK erzwingt das. Beide Identitäten teilen sich die Tabelle,
/// weil die Zeremonie dieselbe ist — getrennt bleiben sie dort, wo es zählt: in
/// Sitzung und Cookie.
model WebAuthnCredential {
  id          String     @id @default(cuid())
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  /// Die Kennung des Schlüssels, wie der Authenticator sie nennt (base64url).
  credentialId String  @unique
  publicKey    String
  /// Zählt jede Signatur hoch. Ein Rückschritt heißt: der Schlüssel ist kopiert.
  counter      Int     @default(0)
  transports   String?
  /// Frei vergebener Name — „Telefon", „Rechner im Büro".
  label        String

  /// Gesperrt nach erkanntem Klon. Ein gesperrter Passkey meldet niemanden an.
  disabledAt DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([adminUserId])
}

/// Die Aufgabe einer laufenden WebAuthn-Zeremonie (M9).
///
/// Sie ist einmal verwendbar und kurzlebig. Der Grund ist derselbe wie beim
/// Nachweis des zweiten Anmeldeschritts: Was Zugang vorbereitet, soll nicht
/// herumliegen.
///
/// Anders als dort darf **beides** leer sein: Bei der Anmeldung mit einem
/// auffindbaren Passkey ist zum Zeitpunkt der Aufgabe noch nicht bekannt, wer
/// sich anmeldet — das nennt erst der Authenticator. Ein CHECK erzwingt
/// deshalb nur, dass nicht **beide** gesetzt sind.
model WebAuthnChallenge {
  id          String   @id @default(cuid())
  challenge   String
  /// `REGISTER` oder `AUTHENTICATE`.
  kind        String
  userId      String?
  adminUserId String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
}
